@model HospitalAppointmentSystem.Models.Appointment

@{
    ViewData["Title"] = "Book Appointment";

    var doctor = ViewBag.Doctor
        as HospitalAppointmentSystem.Models.Doctor;
}

<h1>Book Appointment</h1>

@if (doctor != null)
{
    <div class="card mb-4">

        <div class="card-body">

            <h4>Doctor Information</h4>

            <p>
                <strong>Doctor:</strong>
                @doctor.DoctorName
            </p>

            <p>
                <strong>Specialization:</strong>
                @doctor.Specialization
            </p>

            <p>
                <strong>Consultation Fee:</strong>
                ₹@doctor.ConsultationFee
            </p>

        </div>

    </div>
}

<form asp-controller="Doctor"
      asp-action="Appointment"
      method="post">

    @Html.AntiForgeryToken()

    <!-- Hidden Field -->
    <input type="hidden"
           asp-for="DoctorId" />

    <div class="mb-3">

        <label asp-for="PatientName"
               class="form-label">
            Patient Name
        </label>

        <input asp-for="PatientName"
               class="form-control" />

        <span asp-validation-for="PatientName"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3">

        <label asp-for="AppointmentDate"
               class="form-label">
            Appointment Date
        </label>

        <input asp-for="AppointmentDate"
               type="date"
               class="form-control" />

        <span asp-validation-for="AppointmentDate"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3">

        <label asp-for="Reason"
               class="form-label">
            Reason
        </label>

        <textarea asp-for="Reason"
                  class="form-control">
        </textarea>

    </div>

    <button type="submit"
            class="btn btn-primary">
        Submit Appointment
    </button>

    <a asp-controller="Doctor"
       asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
